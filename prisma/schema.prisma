// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Example model - you can add your own models
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product{
  id String @id @default(uuid())
  image String
  name String
  ratingStars Float
  ratingCount Int
  priceCents Int

  keywords Keyword []
}

model Keyword {
  id Int @id @default(autoincrement())
  word String @unique

  products Product[]
}

model DeliveryOption {
  id String @id
  deliveryDays Int
  priceCents Int
}
