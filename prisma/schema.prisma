// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Example model - you can add your own models
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product{
  id String @id @default(uuid())
  image String
  name String
  ratingStars Float
  ratingCount Int
  priceCents Int

  keywords Keyword []
  cartItems CartItem []
}

model Keyword {
  id Int @id @default(autoincrement())
  word String @unique

  products Product[]
}

model DeliveryOption {
  id String @id
  deliveryDays Int
  priceCents Int
  cartItems CartItem []
}

model Cart {
  id String @id @default(uuid())
  cartItems CartItem []

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(uuid())
  quantity Int

  //relation of CartItem to Cart
  cartId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  //relation of CartItem to Product
  productId String
  product Product @relation(fields: [productId], references: [id])

  //relation of CartItem to DeliveryOption
  deliveryOptionId String
  deliveryOption DeliveryOption @relation(fields: [deliveryOptionId], references: [id])

  @@unique([cartId,productId]) //so multiple quantities of same product dont show up twice as two rows
}