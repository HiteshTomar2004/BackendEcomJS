// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String?
  tokenVersion  Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts          Cart[]
  orders         Order[]
}

model Product{
  id String @id @default(uuid())
  image String
  name String
  ratingStars Float
  ratingCount Int
  priceCents Int

  keywords Keyword []
  cartItems CartItem []
  orderItem OrderItem []
}

model Keyword {
  id Int @id @default(autoincrement())
  word String @unique

  products Product[]
}

model DeliveryOption {
  id String @id
  deliveryDays Int
  priceCents Int
  cartItems CartItem []
}

model Cart {
  id String @id @default(uuid())
  cartItems CartItem []

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String?  
  user      User?    @relation(fields: [userId], references: [id])
}

model CartItem {
  id String @id @default(uuid())
  quantity Int

  //relation of CartItem to Cart
  cartId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  //relation of CartItem to Product
  productId String
  product Product @relation(fields: [productId], references: [id])

  //relation of CartItem to DeliveryOption
  deliveryOptionId String
  deliveryOption DeliveryOption @relation(fields: [deliveryOptionId], references: [id])

  @@unique([cartId,productId]) //so multiple quantities of same product dont show up twice as two rows
}

model Order {
  id             String @id @default(uuid())
  totalCostCents Int
  createdAt      DateTime @default(now())

  orderItem      OrderItem []
  
  userId         String?
  user           User?    @relation(fields:[userId], references: [id])
}

model OrderItem {
  id String @id @default(uuid())
  
  //saved here so if delivery times are updated in future it wont affect historical delivery times
  quantity Int
  estimatedDeliveryTime DateTime

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id])

}